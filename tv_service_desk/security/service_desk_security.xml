<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_service_desk">
        <field name="name">Service Desk</field>
        <field name="category_id" ref="base.module_category_services_helpdesk"/>
    </record>

    <record id="group_portal_manager" model="res.groups">
        <field name="name">Portal Manager</field>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="group_portal_support" model="res.groups">
        <field name="name">Portal Support User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="group_service_desk_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_service_desk"/>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('mail.group_mail_notification_type_inbox')),
        ]"/>
    </record>

    <!-- Functional Privilege Groups -->
    <record id="group_service_desk_crm" model="res.groups">
        <field name="name">CRM Helpdesk Ticket</field>
        <field name="implied_ids" eval="[(4, ref('group_service_desk_user'))]"/>
    </record>

    <record id="group_service_desk_sale" model="res.groups">
        <field name="name">Sale Helpdesk Ticket</field>
        <field name="implied_ids" eval="[(4, ref('group_service_desk_user'))]"/>
    </record>

    <record id="group_service_desk_purchase" model="res.groups">
        <field name="name">Purchase Helpdesk Ticket</field>
        <field name="implied_ids" eval="[(4, ref('group_service_desk_user'))]"/>
    </record>

    <record id="group_service_desk_invoice" model="res.groups">
        <field name="name">Invoice Helpdesk Ticket</field>
        <field name="implied_ids" eval="[(4, ref('group_service_desk_user'))]"/>
    </record>

    <record id="group_service_desk_timesheet" model="res.groups">
        <field name="name">Helpdesk Ticket Timesheet</field>
        <field name="implied_ids" eval="[
            (4, ref('group_service_desk_user')),
            (4, ref('hr_timesheet.group_hr_timesheet_user')),
        ]"/>
    </record>

    <record id="group_service_desk_task" model="res.groups">
        <field name="name">Helpdesk Task</field>
        <field name="implied_ids" eval="[(4, ref('group_service_desk_user'))]"/>
    </record>

    <record id="group_service_desk_mass_update" model="res.groups">
        <field name="name">Mass Ticket Update</field>
        <field name="implied_ids" eval="[(4, ref('group_service_desk_user'))]"/>
    </record>

    <record id="group_service_desk_whatsapp" model="res.groups">
        <field name="name">Helpdesk Whatsapp Feature</field>
        <field name="implied_ids" eval="[(4, ref('group_service_desk_user'))]"/>
    </record>

    <record id="group_service_desk_sla_policy" model="res.groups">
        <field name="name">Helpdesk SLA Policy</field>
        <field name="implied_ids" eval="[(4, ref('group_service_desk_user'))]"/>
    </record>

    <record id="group_service_desk_ticket_alarm" model="res.groups">
        <field name="name">Helpdesk Ticket Alarm</field>
        <field name="implied_ids" eval="[(4, ref('group_service_desk_user'))]"/>
    </record>

    <record id="group_service_desk_repair" model="res.groups">
        <field name="name">Repair Helpdesk Ticket</field>
        <field name="implied_ids" eval="[
            (4, ref('group_service_desk_user')),
            (4, ref('stock.group_stock_user')),
        ]"/>
    </record>

    <record id="group_service_desk_custom" model="res.groups">
        <field name="name">Helpdesk custom Field and tab</field>
        <field name="implied_ids" eval="[(4, ref('group_service_desk_user'))]"/>
    </record>

    <record id="group_service_desk_sticky_note_user" model="res.groups">
        <field name="name">Sticky Notes User</field>
        <field name="implied_ids" eval="[(4, ref('group_service_desk_user'))]"/>
    </record>

    <record id="group_service_desk_sticky_note_manager" model="res.groups">
        <field name="name">Sticky Notes Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_service_desk_sticky_note_user'))]"/>
    </record>

    <!-- Role Groups -->
    <record id="group_service_desk_team_leader" model="res.groups">
        <field name="name">Team Leader</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_service_desk"/>
        <field name="implied_ids" eval="[
            (4, ref('group_service_desk_user')),
            (4, ref('group_service_desk_crm')),
            (4, ref('group_service_desk_sale')),
            (4, ref('group_service_desk_purchase')),
            (4, ref('group_service_desk_invoice')),
            (4, ref('group_service_desk_timesheet')),
            (4, ref('group_service_desk_task')),
            (4, ref('group_service_desk_whatsapp')),
            (4, ref('group_service_desk_ticket_alarm')),
            (4, ref('group_service_desk_repair')),
            (4, ref('group_service_desk_custom')),
            (4, ref('group_service_desk_sticky_note_user')),
            (4, ref('group_service_desk_mass_update')),
        ]"/>
    </record>

    <record id="group_service_desk_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_service_desk"/>
        <field name="implied_ids" eval="[
            (4, ref('group_service_desk_team_leader')),
            (4, ref('group_service_desk_sticky_note_manager')),
            (4, ref('group_service_desk_sla_policy')),
        ]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>


    <record id="rule_service_desk_ticket_user" model="ir.rule">
        <field name="name">Service Desk Ticket: User sees assigned or team tickets</field>
        <field name="model_id" ref="model_service_desk_ticket"/>
        <field name="domain_force">['|', '|', '|', '|',
            ('user_id', '=', user.id),
            ('assigned_user_ids', 'in', user.id),
            ('team_id.member_ids', 'in', user.id),
            ('team_id.leader_id', '=', user.id),
            ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_service_desk_user'))]"/>
    </record>

    <record id="rule_service_desk_ticket_leader" model="ir.rule">
        <field name="name">Service Desk Ticket: Team Leader sees team tickets</field>
        <field name="model_id" ref="model_service_desk_ticket"/>
        <field name="domain_force">['|',
            ('team_id.leader_id', '=', user.id),
            ('team_id.member_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_service_desk_team_leader'))]"/>
    </record>

    <record id="rule_service_desk_ticket_manager" model="ir.rule">
        <field name="name">Service Desk Ticket: Manager sees all</field>
        <field name="model_id" ref="model_service_desk_ticket"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_service_desk_manager'))]"/>
    </record>

    <record id="rule_service_desk_ticket_company" model="ir.rule">
        <field name="name">Service Desk Ticket: Multi-company</field>
        <field name="model_id" ref="model_service_desk_ticket"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_service_desk_team_company" model="ir.rule">
        <field name="name">Service Desk Team: Multi-company</field>
        <field name="model_id" ref="model_service_desk_team"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_service_desk_support_contract_company" model="ir.rule">
        <field name="name">Support Contract: Multi-company</field>
        <field name="model_id" ref="model_service_desk_support_contract"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_service_desk_customer_hour_package_company" model="ir.rule">
        <field name="name">Customer Hour Package: Multi-company</field>
        <field name="model_id" ref="model_service_desk_customer_hour_package"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_service_desk_sticky_note_user" model="ir.rule">
        <field name="name">Sticky Note: User sees own and shared notes</field>
        <field name="model_id" ref="model_service_desk_sticky_note"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('is_shared', '=', True)]</field>
        <field name="groups" eval="[(4, ref('group_service_desk_sticky_note_user'))]"/>
    </record>

    <record id="rule_service_desk_sticky_note_manager" model="ir.rule">
        <field name="name">Sticky Note: Manager sees all</field>
        <field name="model_id" ref="model_service_desk_sticky_note"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_service_desk_sticky_note_manager'))]"/>
    </record>

    <record id="rule_service_desk_sticky_note_company" model="ir.rule">
        <field name="name">Sticky Note: Multi-company</field>
        <field name="model_id" ref="model_service_desk_sticky_note"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_service_desk_knowledge_article_company" model="ir.rule">
        <field name="name">Knowledge Article: Multi-company</field>
        <field name="model_id" ref="model_service_desk_knowledge_article"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_service_desk_sla_company" model="ir.rule">
        <field name="name">SLA Policy: Multi-company</field>
        <field name="model_id" ref="model_service_desk_sla_policy"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_service_desk_ticket_portal_manager" model="ir.rule">
        <field name="name">Service Desk Ticket: Portal Manager sees company tickets</field>
        <field name="model_id" ref="model_service_desk_ticket"/>
        <field name="domain_force">[('partner_id', 'child_of', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_portal_manager'))]"/>
    </record>

    <record id="rule_service_desk_ticket_portal_support" model="ir.rule">
        <field name="name">Service Desk Ticket: Portal Support sees own tickets</field>
        <field name="model_id" ref="model_service_desk_ticket"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_portal_support'))]"/>
    </record>

    <record id="rule_analytic_line_service_desk_ticket" model="ir.rule">
        <field name="name">Analytic Line: Service Desk Ticket Access</field>
        <field name="model_id" ref="analytic.model_account_analytic_line"/>
        <field name="domain_force">[
            ('sd_ticket_id', '!=', False),
            '|', '|', '|', '|',
                ('sd_ticket_id.user_id', '=', user.id),
                ('sd_ticket_id.assigned_user_ids', 'in', user.id),
                ('sd_ticket_id.team_id.member_ids', 'in', user.id),
                ('sd_ticket_id.team_id.leader_id', '=', user.id),
                ('sd_ticket_id.create_uid', '=', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('hr_timesheet.group_hr_timesheet_user'))]"/>
    </record>
</odoo>
