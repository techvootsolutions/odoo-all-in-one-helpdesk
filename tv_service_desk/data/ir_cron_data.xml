<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_service_desk_auto_close" model="ir.cron">
        <field name="name">Service Desk: Auto-close Inactive Tickets</field>
        <field name="model_id" ref="model_service_desk_ticket"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_close_tickets()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_service_desk_reminders" model="ir.cron">
        <field name="name">Service Desk: Ticket Reminders</field>
        <field name="model_id" ref="model_service_desk_ticket"/>
        <field name="state">code</field>
        <field name="code">model._cron_ticket_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_service_desk_sla_monitor" model="ir.cron">
        <field name="name">Service Desk: SLA Monitor</field>
        <field name="model_id" ref="model_service_desk_ticket"/>
        <field name="state">code</field>
        <field name="code">model._cron_sla_monitor()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_service_desk_contract_expiry" model="ir.cron">
        <field name="name">Service Desk: Support Contract Expiry</field>
        <field name="model_id" ref="model_service_desk_support_contract"/>
        <field name="state">code</field>
        <field name="code">model._cron_contract_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_service_desk_customer_hour_package" model="ir.cron">
        <field name="name">Auto Create Customer Hour Package</field>
        <field name="model_id" ref="model_service_desk_customer_hour_package"/>
        <field name="state">code</field>
        <field name="code">model._run_auto_create_customer_hour_package()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_service_desk_ticket_auto_followup" model="ir.cron">
        <field name="name">Ticket Auto Followup</field>
        <field name="model_id" ref="model_service_desk_ticket"/>
