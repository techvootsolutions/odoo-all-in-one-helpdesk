<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Chatter-safe email bodies: dark text only, no white-on-colored headers.
      Odoo 19 renders outgoing emails in a shadow DOM on light bubbles — white
      inline text becomes invisible.
    -->

    <record id="mail_template_ticket_created_customer" model="mail.template">
        <field name="name">New Ticket: Send by email</field>
        <field name="model_id" ref="model_service_desk_ticket"/>
        <field name="subject">{{ object.company_id.name }} Your Ticket is generated (Ref {{ object.name }})</field>
        <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="email_to">{{ object.partner_email or object.partner_id.email or '' }}</field>
        <field name="lang">{{ object.partner_id.lang or user.lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="description">Sent to the customer when a new service desk ticket is created.</field>
        <field name="body_html" type="html">
<div style="margin:0;padding:16px;font-family:Arial,sans-serif;color:#212529;line-height:1.5;">
  <h3 style="margin:0 0 12px 0;color:#212529;font-size:16px;font-weight:bold;"><t t-out="object.name">TICKET/0015</t></h3>
  <p style="margin:0 0 10px 0;color:#212529;">Dear <t t-out="object.partner_id.name or object.person_name or 'Customer'">Customer</t>, we received your request.</p>
  <p style="margin:0 0 16px 0;color:#212529;">Our Support Team will contact you as soon as possible.</p>
  <a t-att-href="object.get_portal_url()" style="color:#0d6efd;text-decoration:underline;font-weight:bold;">View Ticket</a>
  <div style="margin-top:14px;padding-top:12px;border-top:1px solid #dee2e6;font-size:12px;color:#495057;">
    <table border="0" cellpadding="0" cellspacing="0" style="width:100%;">
      <tr>
        <td style="vertical-align:top;text-align:left;font-size:12px;color:#495057;width:50%;">
          <t t-out="object.company_id.name">My Company</t><br/>
          <t t-out="object.company_id.phone or ''">+1 (650) 555-0111</t>
        </td>
        <td style="vertical-align:top;text-align:right;font-size:12px;color:#495057;width:50%;">
          <t t-out="object.company_id.email or ''">info@yourcompany.com</t><br/>
          <t t-out="object.company_id.website or ''">http://www.example.com</t>
        </td>
      </tr>
    </table>
  </div>
</div>
        </field>
    </record>

