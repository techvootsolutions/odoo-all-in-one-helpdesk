<div style="margin:0;padding:16px;font-family:Arial,sans-serif;color:#212529;line-height:1.5;">
  <p style="margin:0 0 8px 0;color:#212529;">Hello,</p>
  <p style="margin:0 0 8px 0;color:#212529;">SLA has been breached on ticket <strong><t t-out="object.name or ''">SD/2026/00001</t></strong>.</p>
  <p style="margin:0;color:#212529;">Subject: <t t-out="object.subject or ''">Subject</t><br/>
     Customer: <t t-out="object.partner_id.name or 'N/A'">Customer</t><br/>
     Assigned to: <t t-out="object.user_id.name or 'Unassigned'">Agent</t><br/>
     SLA deadline: <t t-out="format_datetime(object.sla_deadline) or ''">2026-01-01</t></p>
</div>
        </field>
    </record>

