<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_desk_reply_wizard_form" model="ir.ui.view">
        <field name="name">service.desk.reply.wizard.form</field>
        <field name="model">service.desk.reply.wizard</field>
        <field name="arch" type="xml">
            <form string="Reply to Customer">
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="not partner_opt_out_helpdesk_emails">
                    This partner has opted out of Helpdesk emails. Customer email notifications
                    will not be sent.
                </div>
                <group>
                    <field name="ticket_id" invisible="1"/>
                    <field name="partner_id" invisible="1"/>
                    <field name="partner_opt_out_helpdesk_emails" invisible="1"/>
                    <field name="email_to" invisible="1"/>
                    <field name="subject"/>
                </group>
                <group>
                    <field name="body" nolabel="1" colspan="2"/>
                </group>
                <group>
                    <field name="attachment_ids" widget="many2many_binary" string="Attachments"/>
                </group>
                <group>
                    <field name="template_id" string="Load template" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_send_reply" type="object" string="Send" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                    <button name="action_save_template" type="object" string="Save Template" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
