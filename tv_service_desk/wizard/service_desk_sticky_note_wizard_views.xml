<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_desk_sticky_note_wizard_form" model="ir.ui.view">
        <field name="name">service.desk.sticky.note.wizard.form</field>
        <field name="model">service.desk.sticky.note.wizard</field>
        <field name="arch" type="xml">
            <form string="New Note">
                <group>
                    <field name="ticket_id" invisible="1"/>
                    <field name="note_id" invisible="1"/>
                    <label for="name"/>
                    <div class="o_row">
                        <field name="name" nolabel="1" class="oe_inline"/>
                        <field name="color" widget="color" nolabel="1"/>
                    </div>
                </group>
                <field name="note" nolabel="1" class="o_sd_sticky_note_wizard_body"/>
                <group>
                    <field name="is_shared" string="Share Note"/>
                    <field name="shared_user_ids" widget="many2many_avatar_user"
                           invisible="not is_shared"/>
                </group>
                <footer>
                    <button name="action_save" type="object" string="Save" class="btn-primary"/>
                    <button string="Discard" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
