<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_desk_create_repair_wizard" model="ir.ui.view">
        <field name="name">service.desk.create.repair.wizard.form</field>
        <field name="model">service.desk.create.repair.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Repair Order">
                <group>
                    <field name="ticket_id" readonly="1"/>
                    <field name="partner_id"/>
                    <field name="product_id"/>
                    <field name="location_id"/>
                    <field name="description"/>
                </group>
                <footer>
                    <button name="action_create_repair" type="object" string="Create Repair" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
