<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_desk_custom_field_wizard_form" model="ir.ui.view">
        <field name="name">service.desk.custom.field.wizard.form</field>
        <field name="model">service.desk.custom.field.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Custom Fields">
                <group>
                    <group>
                        <field name="ticket_id" invisible="1"/>
                        <field name="technical_name"/>
                        <field name="label"/>
                        <field name="field_type"/>
                        <field name="widget"/>
                        <field name="tab_anchor"/>
                        <field name="anchor_field"/>
                        <field name="position"/>
                        <field name="selection_options" invisible="field_type != 'selection'"/>
                    </group>
                    <group>
                        <field name="help_text"/>
                        <field name="is_required"/>
                        <field name="is_copied"/>
                        <field name="tracking"/>
                    </group>
                </group>
                <notebook>
                    <page string="Access Rights" name="access_rights">
                        <field name="group_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="name" string="Group Name"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_create_field" type="object" string="Create Fields" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
