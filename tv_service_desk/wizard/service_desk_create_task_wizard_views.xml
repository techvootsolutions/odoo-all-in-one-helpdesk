<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_desk_create_task_wizard_form" model="ir.ui.view">
        <field name="name">service.desk.create.task.wizard.form</field>
        <field name="model">service.desk.create.task.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Task">
                <group>
                    <field name="ticket_id" readonly="1"/>
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="user_ids" widget="many2many_tags"/>
                    <field name="description"/>
                </group>
                <footer>
                    <button name="action_create" type="object" string="Create Task" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_create_task_from_ticket" model="ir.actions.act_window">
        <field name="name">Create Task</field>
        <field name="res_model">service.desk.create.task.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
