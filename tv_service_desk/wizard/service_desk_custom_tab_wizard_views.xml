<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_desk_custom_tab_wizard_form" model="ir.ui.view">
        <field name="name">service.desk.custom.tab.wizard.form</field>
        <field name="model">service.desk.custom.tab.wizard</field>
        <field name="arch" type="xml">
            <form string="Helpdesk Ticket Custom Tab">
                <group>
                    <field name="name"/>
                    <field name="label"/>
                    <field name="group_ids" widget="many2many_tags"/>
                    <field name="anchor_tab"/>
                    <field name="position"/>
                </group>
                <footer>
                    <button name="action_create_tab" type="object" string="Create Tab" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
