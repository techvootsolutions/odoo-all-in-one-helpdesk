<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_desk_mass_update_wizard_form" model="ir.ui.view">
        <field name="name">service.desk.mass.update.wizard.form</field>
        <field name="model">service.desk.mass.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Mass Update Ticket">
                <field name="ticket_ids" invisible="1"/>
                <group>
                    <group string="UPDATE TEAM">
                        <field name="update_team" string="Team"/>
                        <field name="team_id" string="Team" invisible="not update_team"/>
                    </group>
                    <group string="UPDATE ASSIGN TO MULTIUSER">
                        <field name="update_assign_multi" string="Assign Multi User"/>
                        <field name="multi_user_action" string="Ticket Type Update"
                               invisible="not update_assign_multi"/>
                        <field name="assigned_user_ids" string="Assign Multi Users"
                               widget="many2many_tags" invisible="not update_assign_multi"/>
                    </group>
                </group>
                <group>
                    <group string="UPDATE ASSIGN TO">
                        <field name="update_assign_to" string="Assign To"/>
                        <field name="user_id" string="Assign To" invisible="not update_assign_to"/>
                    </group>
                    <group string="UPDATE STAGE">
                        <field name="update_stage" string="Stage"/>
                        <field name="stage_id" string="Stages" invisible="not update_stage"/>
                    </group>
                </group>
                <group>
                    <group/>
                    <group string="ADD/REMOVE FOLLOWER">
                        <field name="update_follower" string="Add/Remove"/>
                        <field name="follower_partner_ids" string="Followers"
                               widget="many2many_tags" invisible="not update_follower"/>
                        <field name="follower_action" widget="radio" invisible="not update_follower"/>
                    </group>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Done" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
