<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_task_form_service_desk" model="ir.ui.view">
        <field name="name">project.task.form.service.desk</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_service_desk_tickets" type="object"
                        class="oe_stat_button" icon="fa-ticket"
                        invisible="sd_ticket_count == 0"
                        groups="tv_service_desk.group_service_desk_task">
                    <field name="sd_ticket_count" widget="statinfo" string="Tickets"/>
                </button>
            </div>
            <field name="partner_id" position="after">
                <field name="sd_ticket_id" readonly="1" groups="tv_service_desk.group_service_desk_task"/>
            </field>
        </field>
    </record>
</odoo>
