<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_service_desk" model="ir.ui.view">
        <field name="name">res.partner.form.service.desk</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_service_desk_tickets" type="object"
                        class="oe_stat_button" icon="fa-ticket"
                        groups="tv_service_desk.group_service_desk_user">
                    <field name="sd_ticket_count" widget="statinfo" string="Tickets"/>
                </button>
                <button name="action_view_hour_packages" type="object"
                        class="oe_stat_button" icon="fa-clock-o"
                        groups="tv_service_desk.group_service_desk_user"
                        invisible="sd_hour_package_count == 0">
                    <field name="sd_hour_package_count" widget="statinfo" string="Hour Packages"/>
                </button>
            </div>
            <field name="category_id" position="after">
                <field name="sd_allocated_hours_for_month" string="Allocated Hours For Month"
                       groups="tv_service_desk.group_service_desk_user"/>
                <field name="sd_opt_out_emails" string="Opt Out Helpdesk Emails"
                       groups="tv_service_desk.group_service_desk_user"/>
            </field>
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="Hour Packages" name="hour_packages"
                      groups="tv_service_desk.group_service_desk_user">
                    <field name="sd_hour_package_ids" nolabel="1"
                           context="{'default_partner_id': id}"
                           edit="form">
                        <list create="0">
                            <field name="name"/>
                            <field name="partner_id" string="Customer" column_invisible="True"/>
                            <field name="date_start" string="Package Date"/>
                            <field name="initial_allocated_hours" widget="float_time"/>
                            <field name="rolled_over_hours" widget="float_time"/>
                            <field name="total_allocated_hours" widget="float_time"/>
                            <field name="hours_consumed" widget="float_time"/>
                            <field name="remaining_hours" widget="float_time"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'open'"
                                   decoration-muted="state == 'close'"/>
                        </list>
                        <form string="Customer Hour Package">
                            <sheet>
                                <group>
                                    <group>
                                        <field name="name" readonly="1"/>
                                        <field name="partner_id" string="Customer" readonly="1"/>
                                        <label for="date_start" string="Package Date"/>
                                        <div class="o_row">
                                            <field name="date_start" nolabel="1" readonly="1"/>
                                            <i class="fa fa-long-arrow-right mx-1" title="to"/>
                                            <field name="date_end" nolabel="1" readonly="1"/>
                                        </div>
                                    </group>
                                    <group>
                                        <field name="initial_allocated_hours" widget="float_time" readonly="1"/>
                                        <field name="rolled_over_hours" widget="float_time" readonly="1"/>
                                        <field name="total_allocated_hours" widget="float_time" readonly="1"/>
                                        <field name="hours_consumed" widget="float_time" readonly="1"/>
                                        <field name="remaining_hours" widget="float_time" readonly="1"/>
                                        <field name="state" widget="badge" readonly="1"/>
                                    </group>
                                </group>
                                <notebook>
                                    <page string="Timesheets" name="timesheets">
                                        <field name="timesheet_line_ids" readonly="1">
                                            <list>
                                                <field name="date"/>
                                                <field name="employee_id"/>
                                                <field name="project_id"/>
                                                <field name="name" string="Description"/>
                                                <field name="unit_amount" widget="float_time" string="Hours Spent"/>
                                                <field name="sd_ticket_id" string="Helpdesk Ticket"/>
                                            </list>
                                        </field>
                                    </page>
                                </notebook>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
