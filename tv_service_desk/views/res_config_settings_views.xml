<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_service_desk" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.service.desk</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Helpdesk" name="tv_service_desk">
                    <block title="Ticket Stage Settings">
                        <setting string="Stage Mapping"
                                 help="Map helpdesk stages used for ticket lifecycle automation."
                                 class="col-12">
                            <div class="content-group">
                                <div class="row g-3">
                                    <div class="col-lg-6">
                                        <label for="sd_stage_draft_id" class="o_light_label">Draft/New Stage</label>
                                        <field name="sd_stage_draft_id" class="w-100"/>
                                    </div>
                                    <div class="col-lg-6">
                                        <label for="sd_stage_reopened_id" class="o_light_label">Re-Opened Stage</label>
                                        <field name="sd_stage_reopened_id" class="w-100"/>
                                    </div>
                                    <div class="col-lg-6">
                                        <label for="sd_stage_cancel_id" class="o_light_label">Cancel Stage</label>
                                        <field name="sd_stage_cancel_id" class="w-100"/>
                                    </div>
                                    <div class="col-lg-6">
                                        <label for="sd_stage_resolved_id" class="o_light_label">Resolved Stage</label>
                                        <field name="sd_stage_resolved_id" class="w-100"/>
                                    </div>
                                    <div class="col-lg-6">
                                        <label for="sd_stage_closed_id" class="o_light_label">Closed Stage</label>
                                        <field name="sd_stage_closed_id" class="w-100"/>
                                    </div>
                                </div>
                            </div>
                        </setting>
                        <setting string="Stage change when customer replied?"
                                 help="Automatically move tickets to the selected stage when the customer replies.">
                            <field name="sd_stage_change_customer_replied"/>
                            <div class="content-group mt16" invisible="not sd_stage_change_customer_replied">
                                <label for="sd_customer_replied_stage_id" class="o_light_label">Customer Replied Stage</label>
                                <field name="sd_customer_replied_stage_id" class="w-100 mt8"/>
                            </div>
                        </setting>
                        <setting string="Stage change when staff replied?"
                                 help="Automatically move tickets to the selected stage when staff replies.">
                            <field name="sd_stage_change_staff_replied"/>
                            <div class="content-group mt16" invisible="not sd_stage_change_staff_replied">
                                <label for="sd_staff_replied_stage_id" class="o_light_label">Staff Replied Stage</label>
                                <field name="sd_staff_replied_stage_id" class="w-100 mt8"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Ticket Mail Template Settings">
                        <setting string="Ticket Allocation To User Mail Template">
                            <field name="sd_allocation_mail_template_id" class="w-100"
                                   options="{'no_create': True}"/>
                        </setting>
                        <setting string="Ticket Reply Mail Template">
                            <field name="sd_reply_mail_template_id" class="w-100"
                                   options="{'no_create': True}"/>
                        </setting>
                        <setting string="Get email when customer view ticket?">
                            <field name="sd_email_on_customer_view"/>
                        </setting>
                        <setting string="Portal View Ticket with Access Token">
                            <field name="sd_portal_view_access_token"/>
                        </setting>
                    </block>
                    <block title="Ticket Dashboard Settings">
                        <setting string="Dashboard Filter"
                                 help="Stages displayed as KPI cards on the dashboard and ticket list.">
                            <field name="sd_dashboard_filter_stage_ids" widget="many2many_tags"
                                   options="{'color_field': 'color', 'no_create': True}"/>
                        </setting>
                        <setting string="Dashboard Tables"
                                 help="Stages displayed as accordion ticket tables on the dashboard.">
                            <field name="sd_dashboard_table_stage_ids" widget="many2many_tags"
                                   options="{'color_field': 'color', 'no_create': True}"/>
                        </setting>
                        <setting string="Dashboard Page Limit"
                                 help="Number of tickets shown per stage table on the dashboard.">
                            <field name="sd_dashboard_pager_limit"/>
                        </setting>
                        <setting string="Show Extended Dashboard KPIs"
                                 help="Show Total, My Tickets, SLA, Rating and Contract KPI cards.">
                            <field name="sd_dashboard_show_extended_kpis"/>
                        </setting>
                        <setting string="Default Date Filter"
                                 help="Date filter applied when the dashboard first opens.">
                            <field name="sd_default_date_filter"/>
                        </setting>
                    </block>
                    <block title="Manage Products Inside Helpdesk Ticket">
                        <setting string="Manage Products">
                            <field name="sd_manage_products"/>
                        </setting>
                    </block>
                    <block title="Ticket Timesheet Configuration">
                        <setting string="Default Description In Timesheet ?">
                            <field name="sd_default_timesheet_description"/>
                        </setting>
                        <setting string="Multiple Ticket Allowed ?">
                            <field name="sd_allow_parallel_timers"/>
                        </setting>
                        <setting string="Default Project">
                            <field name="sd_default_timesheet_project_id"/>
                        </setting>
                    </block>
                    <block title="Customer Hour Package Configuration">
                        <setting string="Allocated Hours For Month">
                            <field name="sd_allocated_hours_for_month"/>
                        </setting>
                    </block>
                    <block title="Ticket Auto Followup Configuration">
                        <setting string="Auto Followup Stage">
                            <field name="sd_auto_followup_stage_id"/>
                        </setting>
                    </block>
                    <block title="Ticket Notification Configuration">
                        <setting string="Send Notification When Creating Ticket">
                            <field name="sd_notify_on_create"/>
                        </setting>
                        <setting string="Send Notification When Ticket is Completed">
                            <field name="sd_notify_on_done"/>
                        </setting>
                        <setting string="Send Notification When Ticket is Assigned">
                            <field name="sd_notify_on_assign"/>
                        </setting>
                        <setting string="Send Notification When Ticket is Cancelled">
                            <field name="sd_notify_on_cancel"/>
                        </setting>
                        <setting string="Send Notification When Ticket Stage is Changed">
                            <field name="sd_notify_on_stage_change"/>
                        </setting>
                    </block>
                    <block title="Helpdesk Ticket Reminder Configuration">
                        <setting string="Ticket Reminder?">
                            <field name="sd_ticket_reminder"/>
                        </setting>
                    </block>
                    <block title="Helpdesk Ticket Send Whatsapp Configuration">
                        <setting string="Ticket Product details in Message?">
                            <field name="sd_whatsapp_product_details"/>
                        </setting>
                        <setting string="Signature?">
                            <field name="sd_whatsapp_signature"/>
                        </setting>
                        <setting string="Display in Chatter Message?">
                            <field name="sd_whatsapp_display_chatter"/>
                        </setting>
                        <setting string="Send Report URL in Message?">
                            <field name="sd_whatsapp_send_report_url"/>
                        </setting>
                        <setting string="Send Ticket URL in Message?">
                            <field name="sd_whatsapp_send_ticket_url"/>
                        </setting>
                    </block>
                    <block title="Helpdesk Auto Add Followers Configuration">
                        <setting string="Auto add customer as follower when create ticket?">
                            <field name="sd_auto_add_customer_follower"/>
                        </setting>
                    </block>
                    <block title="Ticket Settings">
                        <setting string="Category">
                            <field name="sd_category_enabled"/>
                        </setting>
                        <setting string="Sub Category">
                            <field name="sd_subcategory_enabled"/>
                        </setting>
                        <setting string="Customer Rating">
                            <field name="sd_customer_rating_enabled"/>
                        </setting>
                        <setting string="Auto Close Ticket">
                            <field name="sd_auto_close_ticket"/>
                        </setting>
                        <setting string="Portal Attachment Size(KB)">
                            <field name="sd_portal_attachment_size_kb"/>
                        </setting>
                        <setting string="Manual Add Timesheet">
                            <field name="sd_manual_timesheet"/>
                        </setting>
                        <setting string="Default Team">
                            <field name="sd_default_team_id"/>
                        </setting>
                        <setting string="No of Days" invisible="not sd_auto_close_ticket">
                            <field name="sd_no_of_days"/>
                        </setting>
                        <setting string="Default Assign User">
                            <field name="sd_default_assign_user_id"/>
                        </setting>
                    </block>
                    <block title="Multi Users in Ticket Configuration">
                        <setting string="Display Multi Users?"
                                 help="Show the Collaborators field on ticket forms.">
                            <field name="sd_display_multi_users"/>
                        </setting>
                    </block>
                    <block title="General">
                        <setting string="Request Feedback on Close">
                            <field name="sd_feedback_on_close"/>
                        </setting>
                        <setting string="Portal Attachment Limit (MB)">
                            <field name="sd_portal_attachment_limit_mb"/>
                        </setting>
                    </block>
                    <block title="AI Assistant">
                        <setting string="Enable AI Features">
                            <field name="sd_ai_enabled"/>
                        </setting>
                        <setting string="AI API URL" invisible="not sd_ai_enabled">
                            <field name="sd_ai_api_url"/>
                        </setting>
                        <setting string="AI API Key" invisible="not sd_ai_enabled">
                            <field name="sd_ai_api_key" password="True"/>
                        </setting>
                        <setting string="AI Model" invisible="not sd_ai_enabled">
                            <field name="sd_ai_model"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_service_desk_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'tv_service_desk'}</field>
    </record>
</odoo>
