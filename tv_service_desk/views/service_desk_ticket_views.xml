<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban (Screenshot 1) -->
    <record id="view_service_desk_ticket_kanban" model="ir.ui.view">
        <field name="name">service.desk.ticket.kanban</field>
        <field name="model">service.desk.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column o_sd_ticket_kanban" quick_create="true">
                <field name="name"/>
                <field name="subject"/>
                <field name="priority_id"/>
                <field name="ticket_type_id"/>
                <field name="partner_id"/>
                <field name="product_ids"/>
                <field name="tag_ids"/>
                <field name="stage_id"/>
                <field name="user_id"/>
                <field name="create_date"/>
                <field name="replied_status"/>
                <field name="is_unread"/>
                <field name="attachment_count"/>
                <field name="stage_color"/>
                <field name="current_user_timer_running"/>
                <field name="current_user_timer_start"/>
                <field name="active_timer_user_id"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="o_sd_kanban_card o_sd_stage_color_#{record.stage_color.raw_value} #{record.is_unread.raw_value ? 'o_sd_ticket_unread' : ''}">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_record_top mb-1">
                                    <strong t-attf-class="o_kanban_record_title #{record.is_unread.raw_value ? 'fw-bold' : ''}">
                                        <field name="name"/>
                                        <t t-if="record.priority_id.raw_value"> : <field name="priority_id"/></t>
                                    </strong>
                                </div>
                                <div t-attf-class="mb-1 #{record.is_unread.raw_value ? 'fw-bold' : ''}">
                                    <field name="subject"/>
                                </div>
                                <div class="o_sd_kanban_products mb-1" t-if="record.product_ids.raw_value.length">
                                    <field name="product_ids" widget="many2many_tags"/>
                                </div>
                                <div class="small mb-1"><field name="ticket_type_id"/></div>
                                <div t-attf-class="mb-1 #{record.is_unread.raw_value ? 'fw-bold' : ''}"><field name="partner_id"/></div>
                                <div class="mb-1" t-if="record.tag_ids.raw_value.length">
                                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                </div>
                                <div class="small text-muted mb-1">
                                    <field name="stage_id"/>
                                </div>
                                <div class="small text-muted mb-2">
                                    <field name="create_date" widget="datetime"/>
                                </div>
                            </div>
                            <div class="o_sd_kanban_timer_row d-flex align-items-center justify-content-between gap-2"
                                 groups="tv_service_desk.group_service_desk_timesheet">
                                <div class="d-flex align-items-center gap-2">
                                    <t t-if="!record.current_user_timer_running.raw_value">
                                        <button type="object" name="action_start_timer"
                                                class="btn btn-sm o_sd_btn_start">Start</button>
                                    </t>
                                    <t t-else="">
                                        <span class="o_sd_timer_display fw-bold"
                                              t-att-data-start="record.current_user_timer_start.raw_value"/>
                                        <button type="object" name="action_end_ticket"
                                                class="btn btn-sm o_sd_btn_end">End</button>
                                    </t>
                                    <span t-if="record.attachment_count.raw_value" class="text-muted">
                                        <i class="fa fa-paperclip"/>
                                    </span>
                                </div>
                                <field name="active_timer_user_id" widget="many2one_avatar_user"/>
                            </div>
                            <div t-if="record.replied_status.raw_value == 'customer_replied'"
                                 class="o_sd_kanban_replied_footer o_sd_customer_replied_footer">
                                Customer Replied
                            </div>
                            <div t-if="record.replied_status.raw_value == 'staff_replied'"
                                 class="o_sd_kanban_replied_footer o_sd_staff_replied_footer">
                                Staff Replied
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List (Screenshot 2) -->
    <record id="view_service_desk_ticket_list" model="ir.ui.view">
        <field name="name">service.desk.ticket.list</field>
        <field name="model">service.desk.ticket</field>
        <field name="arch" type="xml">
            <list decoration-warning="replied_status == 'customer_replied'"
                  decoration-info="replied_status == 'staff_replied'"
                  decoration-bf="is_unread">
                <field name="is_unread" column_invisible="1"/>
                <field name="name" string="Name"/>
                <field name="partner_id" string="Partner"/>
                <field name="create_date" string="Create Date"/>
                <field name="last_update_date" string="Last Update Date"/>
                <field name="ticket_type_id" string="Ticket Type"/>
                <field name="team_id" string="Team"/>
                <field name="team_head_id" string="Team Head"/>
                <field name="user_id" string="Assigned To" widget="many2one_avatar_user"/>
                <field name="subject_type_id" string="Ticket Subject Type"/>
                <field name="category_id" string="Category"/>
                <field name="subcategory_id" string="Sub Category"/>
                <field name="stage_id" string="Stage"/>
            </list>
        </field>
    </record>

    <!-- Form (Screenshots 8-12) -->
    <record id="view_service_desk_ticket_form" model="ir.ui.view">
        <field name="name">service.desk.ticket.form</field>
        <field name="model">service.desk.ticket</field>
        <field name="arch" type="xml">
            <form class="o_sd_ticket_form">
                <header>
                    <field name="is_timer_running" invisible="1"
                           groups="tv_service_desk.group_service_desk_timesheet"/>
                    <field name="current_user_timer_start" invisible="1"
                           groups="tv_service_desk.group_service_desk_timesheet"/>
                    <button name="action_start_ticket" type="object" string="Start Ticket"
                            class="btn-primary"
                            invisible="is_timer_running or not sd_show_timesheets_tab or not approved"
                            groups="tv_service_desk.group_service_desk_timesheet"/>
                    <button name="action_end_ticket" type="object" string="End Ticket"
                            class="btn-primary"
                            invisible="not is_timer_running or not sd_show_timesheets_tab"
                            groups="tv_service_desk.group_service_desk_timesheet"/>
                    <button name="action_approve_ticket" type="object" string="Approve"
                            class="btn-primary" groups="tv_service_desk.group_service_desk_manager"
                            invisible="approved or not sd_is_helpdesk_manager"/>
                    <button name="action_open_reply_wizard" type="object" string="Reply" class="btn-primary"/>
                    <button name="action_send_by_whatsapp" type="object" string="Send By Whatsapp"
                            class="btn-primary" groups="tv_service_desk.group_service_desk_whatsapp"
                            invisible="not sd_is_helpdesk_manager"/>
                    <button name="action_cancel_ticket" type="object" string="Cancel Ticket"
                            class="btn-primary"
                            invisible="stage_id.is_closed or not sd_is_helpdesk_manager"/>
                    <button name="action_reopen_ticket" type="object" string="Re-Open Ticket"
                            class="btn-primary" invisible="not sd_show_reopen_button"/>
                    <button name="action_open_create_lead_wizard" type="object" string="Create Lead"
                            class="btn-primary" groups="tv_service_desk.group_service_desk_crm"
                            invisible="not sd_is_helpdesk_manager"/>
                    <button name="action_open_create_opportunity_wizard" type="object" string="Create Opportunity"
                            class="btn-primary" groups="tv_service_desk.group_service_desk_crm"
                            invisible="not sd_is_helpdesk_manager"/>
                    <button name="action_open_create_sale_wizard" type="object" string="$ Create Sale Order"
                            class="btn-primary" invisible="not sd_show_products or not sd_is_helpdesk_manager"
                            groups="tv_service_desk.group_service_desk_sale"/>
                    <button name="action_open_create_purchase_wizard" type="object" string="Create Purchase Order"
                            class="btn-primary" invisible="not sd_show_products or not sd_is_helpdesk_manager"
                            groups="tv_service_desk.group_service_desk_purchase"/>
                    <button name="action_open_create_invoice_wizard" type="object" string="Create Invoice"
                            class="btn-primary" invisible="not sd_show_products or not sd_is_helpdesk_manager"
                            groups="tv_service_desk.group_service_desk_invoice"/>
                    <button name="action_open_create_repair_wizard" type="object" string="Create Repair Order"
                            class="btn-primary" groups="tv_service_desk.group_service_desk_repair"
                            invisible="not sd_is_helpdesk_manager"/>
                    <button name="action_open_create_task_wizard" type="object" string="Create Task"
                            class="btn-primary" groups="tv_service_desk.group_service_desk_task"
                            invisible="not sd_is_helpdesk_manager"/>
                    <button name="action_open_add_custom_field_wizard" type="object" string="Add Custom Field"
                            class="btn-primary" groups="tv_service_desk.group_service_desk_custom"
                            invisible="not sd_is_helpdesk_manager"/>
                    <button name="action_open_add_custom_tab_wizard" type="object" string="Add Custom Tab"
                            class="btn-primary" groups="tv_service_desk.group_service_desk_custom"
                            invisible="not sd_is_helpdesk_manager"/>
                    <button name="action_preview_ticket" type="object" string="Preview" class="btn-secondary"/>
                    <button name="action_open_new_sticky_note_wizard" type="object" string="Sticky Notes"
                            class="btn-secondary" icon="fa-thumb-tack"
                            groups="tv_service_desk.group_service_desk_sticky_note_user"
                            invisible="not sd_is_helpdesk_manager"/>
                    <field name="stage_id" widget="statusbar"
                           readonly="not is_team_leader_or_manager"
                           options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <field name="sd_show_reopen_button" invisible="1"/>
                    <field name="sd_show_multi_users" invisible="1"/>
                    <field name="is_team_leader_or_manager" invisible="1"/>

                    <field name="sd_show_products" invisible="1"/>
                    <field name="sd_show_category" invisible="1"/>
                    <field name="sd_show_subcategory" invisible="1"/>
                    <field name="sd_show_customer_rating" invisible="1"/>
                    <field name="sd_show_reminders" invisible="1"/>
                    <field name="sd_show_assignment_fields" invisible="1"/>
                    <field name="sd_show_real_duration_field" invisible="1"/>
                    <field name="sd_show_customer_rating_tab" invisible="1"/>
                    <field name="sd_show_timesheets_tab" invisible="1"/>
                    <field name="sd_show_followup_tab" invisible="1"/>
                    <field name="sd_is_helpdesk_manager" invisible="1"/>
                    <field name="sd_show_repair_fields" invisible="1"/>
                    <field name="sd_is_support_user" invisible="1"/>
                    <field name="sd_show_sla_badge" invisible="1"/>
                    <field name="sd_show_sla_fields" invisible="1"/>
                    <field name="sd_sla_fields_readonly" invisible="1"/>
                    <field name="sd_show_routing_info" invisible="1"/>
                    <field name="sd_show_other_info_manager_fields" invisible="1"/>
                    <field name="sd_integration_fields_readonly" invisible="1"/>
                    <field name="followup_generated" invisible="1"/>
                    <field name="partner_opt_out_helpdesk_emails" invisible="1"/>
                    <div class="alert alert-warning mb-2" role="alert"
                         invisible="not partner_opt_out_helpdesk_emails">
                        This partner has opted out of Helpdesk emails. Customer email notifications
                        will not be sent.
                    </div>
                    <div class="oe_button_box" name="button_box" invisible="not sd_is_helpdesk_manager">
                        <button name="action_view_leads" type="object" class="oe_stat_button" icon="fa-star"
                                invisible="lead_count == 0"
                                groups="tv_service_desk.group_service_desk_crm">
                            <field name="lead_count" widget="statinfo" string="Leads"/>
                        </button>
                        <button name="action_view_opportunities" type="object" class="oe_stat_button" icon="fa-star"
                                invisible="opportunity_count == 0"
                                groups="tv_service_desk.group_service_desk_crm">
                            <field name="opportunity_count" widget="statinfo" string="Opportunities"/>
                        </button>
                        <button name="action_view_sales" type="object" class="oe_stat_button" icon="fa-usd"
                                invisible="sale_count == 0"
                                groups="tv_service_desk.group_service_desk_sale">
                            <field name="sale_count" widget="statinfo" string="Sales"/>
                        </button>
                        <button name="action_view_purchases" type="object" class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="purchase_count == 0"
                                groups="tv_service_desk.group_service_desk_purchase">
                            <field name="purchase_count" widget="statinfo" string="Purchases"/>
                        </button>
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible="invoice_count == 0"
                                groups="tv_service_desk.group_service_desk_invoice">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                        <button name="action_view_tasks" type="object" class="oe_stat_button" icon="fa-tasks"
                                invisible="task_count == 0"
                                groups="tv_service_desk.group_service_desk_task">
                            <field name="task_count" widget="statinfo" string="Tasks"/>
                        </button>
                        <button name="action_view_repairs" type="object" class="oe_stat_button" icon="fa-wrench"
                                invisible="repair_count == 0"
                                groups="tv_service_desk.group_service_desk_repair">
                            <field name="repair_count" widget="statinfo" string="Repair"/>
                        </button>
                    </div>
                    <div class="o_sd_replied_status_banner o_sd_customer_replied_banner mb-2"
                         invisible="replied_status != 'customer_replied'">
                        Customer Replied
                    </div>
                    <div class="o_sd_replied_status_banner o_sd_staff_replied_banner mb-2"
                         invisible="replied_status != 'staff_replied'">
                        Staff Replied
                    </div>
                    <div class="mb-2" invisible="not sla_reach_label or not sd_show_sla_badge">
                        <span class="badge text-bg-info" invisible="sla_status != 'partially_passed' and sla_status != 'ongoing'">
                            <field name="sla_reach_label" readonly="1" nolabel="1"/>
                        </span>
                        <span class="badge text-bg-success" invisible="sla_status != 'passed'">
                            <field name="sla_reach_label" readonly="1" nolabel="1"/>
                        </span>
                        <span class="badge text-bg-danger" invisible="sla_status != 'failed'">
                            <field name="sla_reach_label" readonly="1" nolabel="1"/>
                        </span>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h2><field name="subject" placeholder="Email Subject ...."/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="replied_status" readonly="sd_is_support_user"/>
                            <field name="ticket_type_id"/>
                            <field name="team_id" invisible="not sd_show_assignment_fields"
                                   readonly="sd_is_support_user"/>
                            <field name="team_head_id" readonly="1" invisible="not sd_show_assignment_fields"/>
                            <field name="user_id" invisible="not sd_show_assignment_fields"
                                   readonly="sd_is_support_user"/>
                            <field name="assigned_user_ids" widget="many2many_tags"
                                   invisible="not sd_show_multi_users or not sd_show_assignment_fields"
                                   readonly="sd_is_support_user"/>
                            <field name="sd_create_assign_status" readonly="1"
                                   invisible="not sd_show_routing_info or not sd_create_assign_status"/>
                            <field name="sd_create_notify_summary" readonly="1"
                                   invisible="not sd_show_routing_info or not sd_create_notify_summary"/>
                            <field name="subject_type_id"/>
                            <field name="category_id" invisible="not sd_show_category"/>
                            <field name="subcategory_id" invisible="not sd_show_subcategory"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="priority_id"/>
                            <field name="real_duration" string="Real Duration" readonly="1"
                                   invisible="not sd_show_real_duration_field"/>
                        </group>
                        <group>
                            <field name="create_date" string="Create Date" readonly="1"/>
                            <field name="last_update_date" string="Last Update Date" readonly="1"/>
                            <field name="reminder_due_date" string="Reminder Due Date" widget="datetime"
                                   invisible="not sd_show_reminders"
                                   readonly="sd_is_support_user"/>
                            <field name="partner_id"/>
                            <field name="person_name"/>
                            <field name="partner_email" string="Email"/>
                            <field name="partner_phone" string="Mobile"/>
                            <field name="replied_date" string="Replied Date" readonly="1"/>
                            <field name="product_ids" widget="many2many_tags" string="Products"
                                   invisible="not sd_show_products"
                                   readonly="sd_integration_fields_readonly"/>
                            <field name="repair_product_id" string="Repair Product"
                                   groups="tv_service_desk.group_service_desk_repair"
                                   invisible="not sd_show_repair_fields"/>
                            <field name="repair_order_ids" widget="many2many_tags" string="Repair Orders"
                                   groups="tv_service_desk.group_service_desk_repair"
                                   invisible="not sd_show_repair_fields"/>
                            <field name="lead_ids" widget="many2many_tags" string="Leads/Opportunities"
                                   groups="tv_service_desk.group_service_desk_crm"
                                   readonly="sd_integration_fields_readonly"/>
                            <field name="invoice_ids" widget="many2many_tags" string="Invoices"
                                   groups="tv_service_desk.group_service_desk_invoice"
                                   readonly="sd_integration_fields_readonly"/>
                            <field name="purchase_order_ids" widget="many2many_tags" string="Purchase Orders"
                                   groups="tv_service_desk.group_service_desk_purchase"
                                   readonly="sd_integration_fields_readonly"/>
                            <field name="sale_order_ids" widget="many2many_tags" string="Sale Orders"
                                   groups="tv_service_desk.group_service_desk_sale"
                                   readonly="sd_integration_fields_readonly"/>
                            <field name="sla_deadline" string="SLA Deadline"
                                   readonly="sd_sla_fields_readonly"
                                   invisible="not sd_show_sla_fields"/>
                            <field name="alarm_ids" widget="many2many_tags" string="Ticket Reminders"
                                   invisible="not sd_show_reminders"
                                   readonly="sd_is_support_user"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="auto_followup" string="Auto Follow-up"
                                   invisible="not sd_show_followup_tab"/>
                            <field name="followup_template_id" string="Followup Template"
                                   invisible="not sd_show_followup_tab or not auto_followup"/>
                            <field name="lead_count" invisible="1" groups="tv_service_desk.group_service_desk_manager"/>
                            <field name="opportunity_count" invisible="1" groups="tv_service_desk.group_service_desk_manager"/>
                            <field name="sale_count" invisible="1" groups="tv_service_desk.group_service_desk_manager"/>
                            <field name="purchase_count" invisible="1" groups="tv_service_desk.group_service_desk_manager"/>
                            <field name="invoice_count" invisible="1" groups="tv_service_desk.group_service_desk_manager"/>
                            <field name="repair_count" invisible="1" groups="tv_service_desk.group_service_desk_manager"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Description"/>
                        </page>
                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" nolabel="1"
                                   context="{'default_res_model': 'service.desk.ticket', 'default_res_id': id}">
                                <list editable="bottom" create="1" delete="1">
                                    <field name="name"/>
                                    <field name="res_model"/>
                                    <field name="res_field"/>
                                    <field name="res_id"/>
                                    <field name="type"/>
                                    <field name="file_size"/>
                                    <field name="create_uid"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Customer Rating" name="customer_rating"
                              invisible="not sd_show_customer_rating_tab">
                            <group>
                                <field name="feedback_rating" string="Customer Rating" widget="priority"/>
                                <field name="feedback_comment" string="Customer Comment"/>
                            </group>
                        </page>

                        <page string="Timesheets" name="timesheets"
                              invisible="not sd_show_timesheets_tab">
                            <field name="timesheet_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="employee_id"/>
                                    <field name="project_id"/>
                                    <field name="task_id"/>
                                    <field name="name" string="Description"/>
                                    <field name="so_line" string="Sales Order Item"/>
                                    <field name="unit_amount" string="Hours Spent" widget="float_time"/>
                                    <field name="sd_hour_package_id" string="Customer Hour Package"/>
                                    <field name="sd_ticket_id" string="Helpdesk Ticket"/>
                                </list>
                            </field>
                            <group>
                                <field name="total_hours_spent"/>
                            </group>
                        </page>
                        <page string="Followup History" name="followup_history"
                              invisible="not auto_followup or not sd_show_followup_tab">
                            <field name="followup_history_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="followup_date" string="Date of follow-up"/>
                                    <field name="schedule_date" string="Schedule Date"/>
                                    <field name="mail_template_id" string="Email Template"/>
                                    <field name="status"/>
                                    <field name="failure_reason"/>
                                </list>
                            </field>
                        </page>
                        <page string="Other Information" name="other_information">
                            <group>
                                <group string="TICKET CLOSED INFORMATION">
                                    <field name="close_date" string="Close Date" readonly="sd_sla_fields_readonly"/>
                                    <field name="closed_by_id" string="Closed By" readonly="sd_sla_fields_readonly"/>
                                    <field name="closed_comment" string="Closed Comment" readonly="sd_sla_fields_readonly"/>
                                </group>
                                <group string="TICKET CANCELLED INFORMATION">
                                    <field name="cancelled_date" string="Cancelled Date" readonly="sd_sla_fields_readonly"/>
                                    <field name="cancelled_by_id" string="Cancelled By" readonly="sd_sla_fields_readonly"/>
                                    <field name="cancelled_reason" string="Cancel Reason" readonly="sd_sla_fields_readonly"/>
                                </group>
                            </group>
                            <group>
                                <group string="GENERAL">
                                    <field name="company_id" string="Company" groups="base.group_multi_company"/>
                                    <field name="source" readonly="sd_sla_fields_readonly"/>
                                    <field name="support_contract_id"
                                           invisible="not sd_show_other_info_manager_fields"/>
                                    <field name="resolution_hours" readonly="1"/>
                                </group>
                                <group string="SLA INFORMATION">
                                    <field name="sla_policy_id"
                                           invisible="not sd_show_sla_fields"
                                           readonly="sd_sla_fields_readonly"/>
                                    <field name="sla_deadline"
                                           invisible="not sd_show_sla_fields"
                                           readonly="sd_sla_fields_readonly"/>
                                    <field name="sla_status"
                                           invisible="not sd_show_sla_fields"
                                           readonly="1"/>
                                    <field name="sla_reached_duration"
                                           invisible="not sd_show_sla_fields"
                                           readonly="1"/>
                                    <field name="sla_late_duration"
                                           invisible="not sd_show_sla_fields"
                                           readonly="1"/>
                                    <field name="first_response_deadline"
                                           invisible="not sd_show_sla_fields"
                                           readonly="sd_sla_fields_readonly"/>
                                    <field name="first_response_date"
                                           invisible="not sd_show_sla_fields"
                                           readonly="1"/>
                                    <field name="first_response_status"
                                           invisible="not sd_show_sla_fields"
                                           readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Stage Change History" name="stage_change_history">
                            <field name="stage_log_ids" readonly="1">
                                <list>
                                    <field name="change_date"/>
                                    <field name="old_stage_id"/>
                                    <field name="new_stage_id"/>
                                    <field name="user_id"/>
                                    <field name="duration_hours"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Attachments tab inline list (Screenshot 12) -->
    <record id="view_service_desk_ticket_attachment_list" model="ir.ui.view">
        <field name="name">service.desk.ticket.attachment.list</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="res_model"/>
                <field name="res_field"/>
                <field name="res_id"/>
                <field name="type"/>
                <field name="file_size"/>
                <field name="create_uid"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Search + Search Panel (Screenshots 1-2) -->
    <record id="view_service_desk_ticket_search" model="ir.ui.view">
        <field name="name">service.desk.ticket.search</field>
        <field name="model">service.desk.ticket</field>
        <field name="arch" type="xml">
            <search string="Helpdesk Tickets">
                <field name="name" string="Ticket"/>
                <field name="partner_id" string="Partner"/>
                <field name="ticket_type_id" string="Ticket Type"/>
                <field name="team_id" string="Team"/>
                <field name="team_head_id" string="Team Head"/>
                <field name="user_id" string="Assigned User"/>
                <field name="subject_type_id" string="Ticket Subject Type"/>
                <field name="category_id" string="Category"/>
                <field name="subcategory_id" string="Sub Category"/>
                <field name="stage_id" string="Stage"/>
                <field name="tag_ids" string="Tags"/>
                <field name="product_ids" string="Product"
                       filter_domain="['|', ('product_ids.default_code', 'ilike', self), ('product_ids.name', 'ilike', self)]"/>
                <field name="subject"/>
                
                <filter name="my_tickets" string="My Ticket"
                        domain="['|', ('user_id', '=', uid), ('assigned_user_ids', 'in', [uid])]"/>
                <filter name="filter_leads_opportunities" string="Leads/Opportunities"
                        domain="[('lead_ids', '!=', False)]"
                        groups="tv_service_desk.group_service_desk_crm"/>
                <filter name="filter_sale_order" string="Sale Order"
                        domain="[('sale_order_ids', '!=', False)]"
                        groups="tv_service_desk.group_service_desk_sale"/>
                <filter name="filter_purchase_order" string="Purchase Order"
                        domain="[('purchase_order_ids', '!=', False)]"
                        groups="tv_service_desk.group_service_desk_purchase"/>
                <filter name="filter_invoice" string="Invoice"
                        domain="[('invoice_ids', '!=', False)]"
                        groups="tv_service_desk.group_service_desk_invoice"/>
                <filter name="filter_running_ticket" string="Running Ticket"
                        domain="[('has_running_timer', '=', True)]"
                        groups="tv_service_desk.group_service_desk_timesheet"/>
                <filter name="filter_create_date" string="Creation Date" date="create_date"/>
                <filter name="filter_customer_replied" string="Customer Replied"
                        domain="[('replied_status', '=', 'customer_replied')]"/>
                <filter name="filter_staff_replied" string="Staff Replied"
                        domain="[('replied_status', '=', 'staff_replied')]"/>
                <filter name="completed_tickets" string="Completed Tickets" domain="[('stage_id.name', '=', 'Done')]"/>
                <filter name="cancelled_tickets" string="Cancelled Tickets" domain="[('stage_id.name', '=', 'Cancelled')]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="filter_sla_failed" string="SLA Failed"
                        domain="[('sla_status', '=', 'failed')]"
                        groups="tv_service_desk.group_service_desk_sla_policy"/>
                <filter name="filter_sla_passed" string="SLA Passed"
                        domain="[('sla_status', '=', 'passed')]"
                        groups="tv_service_desk.group_service_desk_sla_policy"/>
                <filter name="filter_sla_partially_passed" string="SLA Partially Passed"
                        domain="[('sla_status', '=', 'partially_passed')]"
                        groups="tv_service_desk.group_service_desk_sla_policy"/>

                <group>
                    <filter name="group_created_by" string="Created By" context="{'group_by': 'create_uid'}"/>
                    <filter name="group_ticket_type" string="Ticket Type" context="{'group_by': 'ticket_type_id'}"/>
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_sub_category" string="Sub Category" context="{'group_by': 'subcategory_id'}"/>
                    <filter name="group_team" string="Team" context="{'group_by': 'team_id'}"/>
                    <filter name="group_team_head" string="Team Head" context="{'group_by': 'team_head_id'}"/>
                    <filter name="group_assigned_user" string="Assigned User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_assigned_multi_users" string="Assinged Multi Users" context="{'group_by': 'assigned_user_ids'}"/>
                    <filter name="group_subject" string="Subject" context="{'group_by': 'subject'}"/>
                    <filter name="group_priority" string="Priority" context="{'group_by': 'priority_id'}"/>
                    <filter name="group_reply_status" string="Reply Status" context="{'group_by': 'replied_status'}"/>
                    <filter name="group_tags" string="Tags" context="{'group_by': 'tag_ids'}"/>
                </group>
                <searchpanel>
                    <field name="company_id" string="Company" icon="fa-building" enable_counters="1"/>
                    <field name="replied_status" string="Replied Status" icon="fa-reply" enable_counters="1"/>
                    <field name="stage_id" string="Stage" icon="fa-folder" enable_counters="1"/>
                    <field name="partner_id" string="Partner" icon="fa-user" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Pivot (Screenshot 3) -->
    <record id="view_service_desk_ticket_pivot" model="ir.ui.view">
        <field name="name">service.desk.ticket.pivot</field>
        <field name="model">service.desk.ticket</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="team_id" type="row"/>
                <field name="user_id" type="row"/>
                <field name="stage_id" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- Graph (Screenshots 4-5) -->
    <record id="view_service_desk_ticket_graph" model="ir.ui.view">
        <field name="name">service.desk.ticket.graph</field>
        <field name="model">service.desk.ticket</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="1">
                <field name="stage_id"/>
                <field name="user_id"/>
            </graph>
        </field>
    </record>

    <!-- Calendar (Screenshot 6) -->
    <record id="view_service_desk_ticket_calendar" model="ir.ui.view">
        <field name="name">service.desk.ticket.calendar</field>
        <field name="model">service.desk.ticket</field>
        <field name="arch" type="xml">
            <calendar string="Helpdesk Tickets" date_start="calendar_date" color="team_id" mode="week" quick_create="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="stage_id"/>
                <field name="calendar_date"/>
            </calendar>
        </field>
    </record>

    <!-- Activity (Screenshot 7) -->
    <record id="view_service_desk_ticket_activity" model="ir.ui.view">
        <field name="name">service.desk.ticket.activity</field>
        <field name="model">service.desk.ticket</field>
        <field name="arch" type="xml">
            <activity string="Helpdesk Tickets">
                <field name="user_id"/>
                <templates>
                    <div t-name="activity-box" class="d-block">
                        <field name="user_id" widget="many2one_avatar_user"/>
                        <div class="fw-bold"><field name="name"/></div>
                        <div class="text-muted"><field name="partner_id"/></div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <record id="action_service_desk_ticket" model="ir.actions.act_window">
        <field name="name">Helpdesk Tickets</field>
        <field name="res_model">service.desk.ticket</field>
        <field name="view_mode">kanban,list,pivot,graph,calendar,activity,form</field>
        <field name="search_view_id" ref="view_service_desk_ticket_search"/>
        <field name="context">{}</field>
    </record>

    <record id="action_service_desk_ticket_merge" model="ir.actions.act_window">
        <field name="name">Merge Ticket</field>
        <field name="res_model">service.desk.merge.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_service_desk_ticket"/>
        <field name="binding_view_types">list</field>
    </record>

    <record id="action_service_desk_ticket_mass_update" model="ir.actions.act_window">
        <field name="name">Mass Update Ticket</field>
        <field name="res_model">service.desk.mass.update.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_service_desk_ticket"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
