<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_desk_ticket_type_list" model="ir.ui.view">
        <field name="name">service.desk.ticket.type.list</field>
        <field name="model">service.desk.ticket.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Ticket Type Form View (Screenshot 5) -->
    <record id="view_service_desk_ticket_type_form" model="ir.ui.view">
        <field name="name">service.desk.ticket.type.form</field>
        <field name="model">service.desk.ticket.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sla_policies" type="object" class="oe_stat_button" icon="fa-tags">
                            <field name="sla_count" widget="statinfo" string="Helpdesk SLA"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Technical"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="follow_up" string="Follow-up?"/>
                        </group>
                    </group>
                    <group string="FOLLOW-UP CONFIGURATION" invisible="not follow_up">
                        <group>
                            <field name="auto_followup_trigger" string="Auto Follow-up trigger?"/>
                        </group>
                        <group>
                            <field name="followup_template_id" string="Followup Template"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Description..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_service_desk_ticket_type" model="ir.actions.act_window">
        <field name="name">Helpdesk Ticket Types</field>
        <field name="res_model">service.desk.ticket.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
