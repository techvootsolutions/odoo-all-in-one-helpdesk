<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale: list + kanban ticket widget -->
    <record id="view_sale_order_tree_helpdesk_ticket_widget" model="ir.ui.view">
        <field name="name">sale.order.list.helpdesk.ticket.widget</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="activity_ids" position="after">
                <field name="sd_ticket_count" string="Tickets" widget="helpdesk_ticket"
                       optional="show" groups="tv_service_desk.group_service_desk_sale"/>
            </field>
        </field>
    </record>

    <record id="view_sale_order_kanban_helpdesk_ticket_widget" model="ir.ui.view">
        <field name="name">sale.order.kanban.helpdesk.ticket.widget</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="sd_ticket_count"/>
            </xpath>
            <xpath expr="//field[@name='activity_ids'][@widget='kanban_activity']" position="after">
                <field name="sd_ticket_count" widget="helpdesk_ticket"
                       groups="tv_service_desk.group_service_desk_sale"/>
            </xpath>
        </field>
    </record>

