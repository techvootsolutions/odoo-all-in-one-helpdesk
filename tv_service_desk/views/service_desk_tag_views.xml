<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_desk_tag_list" model="ir.ui.view">
        <field name="name">service.desk.tag.list</field>
        <field name="model">service.desk.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_service_desk_tag" model="ir.actions.act_window">
        <field name="name">Helpdesk Tags</field>
        <field name="res_model">service.desk.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
