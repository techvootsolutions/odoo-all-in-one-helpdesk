<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_desk_priority_list" model="ir.ui.view">
        <field name="name">service.desk.priority.list</field>
        <field name="model">service.desk.priority</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="weight"/>
            </list>
        </field>
    </record>

    <record id="action_service_desk_priority" model="ir.actions.act_window">
        <field name="name">Helpdesk Priorities</field>
        <field name="res_model">service.desk.priority</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
