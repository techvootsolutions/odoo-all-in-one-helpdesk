<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_desk_ticket_subject_type_list" model="ir.ui.view">
        <field name="name">service.desk.ticket.subject.type.list</field>
        <field name="model">service.desk.ticket.subject.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_service_desk_ticket_subject_type" model="ir.actions.act_window">
        <field name="name">Helpdesk Subject Types</field>
        <field name="res_model">service.desk.ticket.subject.type</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
