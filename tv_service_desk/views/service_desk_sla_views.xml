<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SLA Policies List View (Screenshot 2) -->
    <record id="view_service_desk_sla_list" model="ir.ui.view">
        <field name="name">service.desk.sla.policy.list</field>
        <field name="model">service.desk.sla.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="team_id" string="Helpdesk Team"/>
                <field name="sla_target_type"/>
                <field name="target_stage_id" string="Reach Stage"/>
            </list>
        </field>
    </record>

    <!-- SLA Policies Form View (Screenshot 3) -->
    <record id="view_service_desk_sla_form" model="ir.ui.view">
        <field name="name">service.desk.sla.policy.form</field>
        <field name="model">service.desk.sla.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tickets" type="object" class="oe_stat_button" icon="fa-ticket">
                            <field name="ticket_count" widget="statinfo" string="Tickets"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Reach In 1 Day"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="team_id" string="Helpdesk Team"/>
                            <field name="ticket_type_id" string="Ticket Type"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="SLA Target">
                        <group>
                            <field name="sla_target_type" widget="radio"/>
                            <field name="target_stage_id" string="Reach Stage"/>
                            <label for="sla_days" string="Reach In"/>
                            <div class="o_row">
                                <field name="sla_days" class="oe_inline"/> days, 
                                <field name="sla_hours" class="oe_inline"/> hours, 
                                <field name="sla_minutes" class="oe_inline"/> minutes
                            </div>
                        </group>
                        <group/>
                    </group>
                    <field name="description" placeholder="Description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_service_desk_sla" model="ir.actions.act_window">
        <field name="name">Helpdesk SLA Policies</field>
        <field name="res_model">service.desk.sla.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
