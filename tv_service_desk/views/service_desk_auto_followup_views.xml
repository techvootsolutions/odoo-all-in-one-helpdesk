<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_desk_auto_followup_list" model="ir.ui.view">
        <field name="name">service.desk.auto.followup.list</field>
        <field name="model">service.desk.auto.followup</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_service_desk_auto_followup_form" model="ir.ui.view">
        <field name="name">service.desk.auto.followup.form</field>
        <field name="model">service.desk.auto.followup</field>
        <field name="arch" type="xml">
            <form string="Auto Followup">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <notebook>
                        <page string="Followup Configuration Lines" name="followup_lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="interval"/>
                                    <field name="mail_template_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_service_desk_auto_followup" model="ir.actions.act_window">
        <field name="name">Auto Followup</field>
        <field name="res_model">service.desk.auto.followup</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
