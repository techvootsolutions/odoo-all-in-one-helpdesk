<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_desk_ticket_analysis_pivot" model="ir.ui.view">
        <field name="name">service.desk.ticket.analysis.pivot</field>
        <field name="model">service.desk.ticket.analysis</field>
        <field name="arch" type="xml">
            <pivot string="Ticket Analysis">
                <field name="team_id" type="row"/>
                <field name="stage_id" type="col"/>
                <field name="nbr" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_service_desk_ticket_analysis_graph" model="ir.ui.view">
        <field name="name">service.desk.ticket.analysis.graph</field>
        <field name="model">service.desk.ticket.analysis</field>
        <field name="arch" type="xml">
            <graph string="Tickets" type="bar">
                <field name="team_id"/>
                <field name="nbr" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_service_desk_ticket_analysis_graph_priority" model="ir.ui.view">
        <field name="name">service.desk.ticket.analysis.graph.priority</field>
        <field name="model">service.desk.ticket.analysis</field>
        <field name="arch" type="xml">
            <graph string="Tickets by Priority" type="pie">
                <field name="priority_id"/>
                <field name="nbr" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_service_desk_ticket_analysis_list" model="ir.ui.view">
        <field name="name">service.desk.ticket.analysis.list</field>
        <field name="model">service.desk.ticket.analysis</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="subject"/>
                <field name="team_id"/>
                <field name="user_id"/>
                <field name="category_id"/>
                <field name="priority_id"/>
                <field name="sla_status"/>
                <field name="feedback_rating"/>
                <field name="total_hours_spent"/>
                <field name="close_date"/>
            </list>
        </field>
    </record>

    <record id="action_service_desk_ticket_analysis" model="ir.actions.act_window">
        <field name="name">Ticket Analytics</field>
        <field name="res_model">service.desk.ticket.analysis</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{'search_default_group_team': 1}</field>
    </record>

    <!-- SLA Analysis Pivot View (Screenshot 13) -->
    <record id="view_service_desk_sla_analysis_pivot" model="ir.ui.view">
        <field name="name">service.desk.sla.analysis.pivot</field>
        <field name="model">service.desk.ticket.analysis</field>
        <field name="arch" type="xml">
            <pivot string="Helpdesk SLA Analysis">
                <field name="create_date" interval="month" type="row"/>
                <field name="team_id" type="row"/>
                <field name="sla_status" type="col"/>
                <field name="sla_reached_duration" type="measure"/>
                <field name="sla_late_duration" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_service_desk_sla_analysis" model="ir.actions.act_window">
        <field name="name">Helpdesk SLA Analysis</field>
        <field name="res_model">service.desk.ticket.analysis</field>
        <field name="view_mode">pivot,graph</field>
        <field name="view_id" ref="view_service_desk_sla_analysis_pivot"/>
        <field name="context">{}</field>
    </record>

    <record id="view_service_desk_ticket_rating_pivot" model="ir.ui.view">
        <field name="name">service.desk.ticket.rating.pivot</field>
        <field name="model">service.desk.ticket.rating</field>
        <field name="arch" type="xml">
            <pivot string="Customer Satisfaction">
                <field name="user_id" type="row"/>
                <field name="rating" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_service_desk_ticket_rating_graph" model="ir.ui.view">
        <field name="name">service.desk.ticket.rating.graph</field>
        <field name="model">service.desk.ticket.rating</field>
        <field name="arch" type="xml">
            <graph string="Ratings" type="bar">
                <field name="team_id"/>
                <field name="rating"/>
            </graph>
        </field>
    </record>

    <record id="action_service_desk_ticket_rating_report" model="ir.actions.act_window">
        <field name="name">Customer Ratings</field>
        <field name="res_model">service.desk.ticket.rating</field>
        <field name="view_mode">graph,pivot,list</field>
    </record>

    <record id="view_service_desk_ticket_rating_list" model="ir.ui.view">
        <field name="name">service.desk.ticket.rating.list</field>
        <field name="model">service.desk.ticket.rating</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="ticket_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="team_id"/>
                <field name="rating"/>
                <field name="comment"/>
            </list>
        </field>
    </record>
</odoo>
