<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_desk_knowledge_category_list" model="ir.ui.view">
        <field name="name">service.desk.knowledge.category.list</field>
        <field name="model">service.desk.knowledge.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="article_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_service_desk_knowledge_category_form" model="ir.ui.view">
        <field name="name">service.desk.knowledge.category.form</field>
        <field name="model">service.desk.knowledge.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_service_desk_knowledge_article_list" model="ir.ui.view">
        <field name="name">service.desk.knowledge.article.list</field>
        <field name="model">service.desk.knowledge.article</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="is_published"/>
                <field name="view_count"/>
            </list>
        </field>
    </record>

    <record id="view_service_desk_knowledge_article_form" model="ir.ui.view">
        <field name="name">service.desk.knowledge.article.form</field>
        <field name="model">service.desk.knowledge.article</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category_id"/>
                        <field name="is_published"/>
                        <field name="view_count" readonly="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <field name="tag_ids" widget="many2many_tags"/>
                    <field name="content" widget="html"/>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_service_desk_knowledge_category" model="ir.actions.act_window">
        <field name="name">Knowledge Categories</field>
        <field name="res_model">service.desk.knowledge.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_service_desk_knowledge_article" model="ir.actions.act_window">
        <field name="name">Knowledge Articles</field>
        <field name="res_model">service.desk.knowledge.article</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
