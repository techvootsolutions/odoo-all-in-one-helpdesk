<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_repair_order_form_service_desk" model="ir.ui.view">
        <field name="name">repair.order.form.service.desk</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_service_desk_ticket" type="object" string="Create Ticket"
                        class="btn-primary"
                        groups="tv_service_desk.group_service_desk_repair"/>
            </xpath>
            <div name="button_box" position="inside">
                <button name="action_view_service_desk_tickets" type="object"
                        class="oe_stat_button" icon="fa-ticket"
                        invisible="sd_ticket_count == 0"
                        groups="tv_service_desk.group_service_desk_repair">
                    <field name="sd_ticket_count" widget="statinfo" string="Tickets"/>
                </button>
            </div>
            <field name="tag_ids" position="after">
                <field name="sd_ticket_ids" widget="many2many_tags" string="Tickets"
                       groups="tv_service_desk.group_service_desk_repair"/>
            </field>
        </field>
    </record>

    <record id="view_repair_order_search_service_desk" model="ir.ui.view">
        <field name="name">repair.order.search.service.desk</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form_filter"/>
        <field name="arch" type="xml">
            <filter name="filter_draft" position="before">
                <filter name="filter_helpdesk_ticket" string="Helpdesk Ticket"
                        domain="[('sd_ticket_ids', '!=', False)]"
                        groups="tv_service_desk.group_service_desk_repair"/>
                <separator/>
            </filter>
        </field>
    </record>
</odoo>
