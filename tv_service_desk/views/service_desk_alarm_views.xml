<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_desk_alarm_tree" model="ir.ui.view">
        <field name="name">service.desk.alarm.list</field>
        <field name="model">service.desk.alarm</field>
        <field name="arch" type="xml">
            <list string="Ticket Alarm">
                <field name="name"/>
                <field name="type"/>
                <field name="reminder_before"/>
                <field name="reminder_unit"/>
            </list>
        </field>
    </record>

    <record id="view_service_desk_alarm_form" model="ir.ui.view">
        <field name="name">service.desk.alarm.form</field>
        <field name="model">service.desk.alarm</field>
        <field name="arch" type="xml">
            <form string="Ticket Alarm">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1" force_save="1"/>
                            <field name="reminder_before"/>
                            <field name="reminder_unit"/>
                        </group>
                        <group>
                            <field name="type"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_service_desk_alarm" model="ir.actions.act_window">
        <field name="name">Helpdesk Ticket Alarm</field>
        <field name="res_model">service.desk.alarm</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Helpdesk Ticket Alarm
            </p>
        </field>
    </record>
</odoo>
