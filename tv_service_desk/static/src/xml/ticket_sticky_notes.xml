<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="tv_service_desk.TicketStickyNotes">
        <t t-if="__comp__.props.record.resModel === 'service.desk.ticket' and __comp__.sdStickyState.hasGroup">
            <div class="o_sd_ticket_sticky_notes_wrap px-3 pt-2 pb-1">
                <div class="o_sd_ticket_sticky_notes_toolbar d-flex align-items-center justify-content-between mb-2"
                     t-if="!__comp__.sdStickyState.notes.length">
                    <span class="text-muted small">No sticky notes on this ticket yet.</span>
                    <button type="button" class="btn btn-sm btn-secondary"
                            t-on-click="() => __comp__.sdOpenStickyNoteWizard()">
                        <i class="fa fa-thumb-tack me-1"/>Add Note
                    </button>
                </div>
                <div class="o_sd_ticket_sticky_notes d-flex flex-wrap gap-3" t-if="__comp__.sdStickyState.notes.length">
                <t t-foreach="__comp__.sdStickyState.notes" t-as="note" t-key="note.id">
                    <div class="o_sd_ticket_sticky_note" t-att-style="__comp__.sdNoteBorderStyle(note.color)">
                        <div class="o_sd_ticket_sticky_note_title fw-bold" t-esc="note.name"/>
                        <div class="o_sd_ticket_sticky_note_body" t-out="__comp__.sdNoteBody(note)"/>
                        <div class="o_sd_ticket_sticky_note_footer d-flex align-items-center justify-content-between gap-2">
                            <div class="d-flex align-items-center gap-1">
                                <button t-if="note.has_audio" type="button"
                                        class="btn btn-sm btn-link p-0"
                                        t-on-click="() => __comp__.sdPlayAudio(note)">
                                    <i class="fa fa-play"/>
                                </button>
                                <button t-if="note.can_edit" type="button"
                                        class="btn btn-sm btn-link p-0"
                                        t-on-click="() => __comp__.sdStartRecording(note.id)"
                                        t-att-disabled="__comp__.sdIsRecording(note.id)">
                                    <i class="fa fa-microphone"/>
                                </button>
                                <button t-if="note.can_edit and __comp__.sdIsRecording(note.id)" type="button"
                                        class="btn btn-sm btn-link p-0 text-danger"
                                        t-on-click="() => __comp__.sdStopRecording()">
                                    <i class="fa fa-stop"/>
                                </button>
                                <button t-if="note.can_edit and note.has_audio" type="button"
                                        class="btn btn-sm btn-link p-0 text-danger"
                                        t-on-click="() => __comp__.sdConfirmDeleteAudio(note.id)">
                                    <i class="fa fa-trash"/>
                                </button>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="small" t-esc="note.user_name"/>
                                <i t-if="note.is_shared" class="fa fa-globe text-primary" title="Shared"/>
                                <i t-else="" class="fa fa-users text-muted" title="Private"/>
                                <button t-if="note.can_edit" type="button"
                                        class="btn btn-sm btn-link p-0"
                                        t-on-click="() => __comp__.sdEditNote(note.id)">
                                    <i class="fa fa-pencil"/>
                                </button>
                                <button t-if="note.can_delete" type="button"
                                        class="btn btn-sm btn-link p-0 text-danger"
                                        t-on-click="() => __comp__.sdConfirmArchive(note.id)">
                                    <i class="fa fa-archive"/>
                                </button>
                            </div>
                        </div>
                    </div>
                </t>
                </div>
            </div>
        </t>
    </t>

</templates>
