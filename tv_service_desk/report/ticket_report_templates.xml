<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_service_desk_ticket_document">
        <t t-call="web.external_layout">
            <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; color: #212529;">
                <div class="mb-4">
                    <h2 style="font-size: 28px; font-weight: 700; margin-bottom: 20px;">
                        <span t-field="doc.name"/>
                    </h2>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <table class="table table-sm table-borderless mb-0">
                            <tr>
                                <td style="width: 42%; font-weight: 700;">Ticket Type</td>
                                <td><span t-field="doc.ticket_type_id"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: 700;">Team</td>
                                <td><span t-field="doc.team_id"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: 700;">Team Head</td>
                                <td><span t-field="doc.team_head_id"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: 700;">Assigned User</td>
                                <td><span t-field="doc.user_id"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: 700;">Ticket Subject Type</td>
                                <td><span t-field="doc.subject_type_id"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: 700;">Category</td>
                                <td><span t-field="doc.category_id"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: 700;">Sub Category</td>
                                <td><span t-field="doc.subcategory_id"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: 700;">Priority</td>
                                <td><span t-field="doc.priority_id"/></td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-6">
                        <table class="table table-sm table-borderless mb-0">
                            <tr>
                                <td style="width: 42%; font-weight: 700;">Create Date</td>
                                <td><span t-field="doc.create_date" t-options='{"widget": "date"}'/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: 700;">Last Update Date</td>
                                <td><span t-field="doc.last_update_date" t-options='{"widget": "date"}'/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: 700;">Customer</td>
                                <td><span t-field="doc.partner_id"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: 700;">Person Name</td>
                                <td><span t-field="doc.person_name"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: 700;">Email</td>
                                <td><span t-field="doc.partner_email"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: 700;">Replied Date</td>
                                <td><span t-field="doc.replied_date"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: 700;">Closed Date</td>
                                <td><span t-field="doc.close_date"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: 700;">Closed By</td>
                                <td><span t-field="doc.closed_by_id"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: 700;">Cancelled Date</td>
                                <td><span t-field="doc.cancelled_date"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: 700;">Cancelled Reason</td>
                                <td><span t-field="doc.cancelled_reason"/></td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div class="mb-3" t-if="doc.product_ids">
                    <span style="font-weight: 700;">Products</span>
                    <span class="ms-2">
                        <t t-foreach="doc.product_ids" t-as="product">
                            <t t-if="not product_first">, </t>
                            <span t-esc="product.display_name"/>
                        </t>
                    </span>
                </div>

                <div class="mb-4">
                    <h4 style="font-weight: 700; margin-bottom: 8px;">Description</h4>
                    <div t-if="doc.description">
                        <span t-field="doc.description"/>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-6">
                        <span style="font-weight: 700;">Customer Rating</span>
                        <span class="ms-2" style="font-size: 16px;">
                            <t t-if="doc.feedback_rating == '1'">★☆☆☆☆</t>
                            <t t-elif="doc.feedback_rating == '2'">★★☆☆☆</t>
                            <t t-elif="doc.feedback_rating == '3'">★★★☆☆</t>
                            <t t-elif="doc.feedback_rating == '4'">★★★★☆</t>
                            <t t-elif="doc.feedback_rating == '5'">★★★★★</t>
                            <t t-else="">☆☆☆☆☆</t>
                        </span>
                    </div>
                    <div class="col-6">
                        <span style="font-weight: 700;">Customer Comment</span>
                        <span class="ms-2" t-field="doc.feedback_comment"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_service_desk_ticket">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="tv_service_desk.report_service_desk_ticket_document"/>
            </t>
        </t>
    </template>
</odoo>
